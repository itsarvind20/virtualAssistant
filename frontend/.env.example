VITE_SERVER_URL=http://localhost:8000
VITE_SPEECH_PROVIDER=auto
VITE_WAKE_WORD_PROVIDER=browser
VITE_SPEECH_RECOGNITION_LANG=en-IN
VITE_TTS_LANG=en-IN
VITE_TTS_VOICE=Microsoft Heera Online (Natural) 
VITE_TTS_RATE=0.92
VITE_TTS_PITCH=1.04
VITE_TTS_VOLUME=1
VITE_ASSISTANT_RESPONSE_LANG=en
VITE_CLOUD_TRANSCRIPTION_ENABLED=false

# Porcupine wake word.
# Create a Picovoice access key and a Web/WASM custom keyword model (.ppn)
# for your assistant name in the Picovoice Console.
VITE_PICOVOICE_ACCESS_KEY=
VITE_PORCUPINE_KEYWORD_PATH=
VITE_PORCUPINE_MODEL_PATH=
VITE_PORCUPINE_SENSITIVITY=0.65

# Vosk offline speech-to-text.
# Put a Vosk browser model tarball in frontend/public/voice-models.
VITE_VOSK_MODEL_PATH=
